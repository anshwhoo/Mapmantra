# MapMantra — Environment Configuration

# Email Ingestion (Option 3) — leave blank to skip
EMAIL_HOST=
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX

# Ollama Configuration
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Agents run concurrently and Ollama queues their requests, so allow long waits
OLLAMA_TIMEOUT_SECONDS=600
# qwen3 "thinking" is off by default (agents only need JSON; thinking can loop for minutes)
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3072

# Scheduler Configuration (Intervals in Minutes)
INGESTION_INTERVAL_MINUTES=1440
SUPERVISOR_INTERVAL_MINUTES=30
# Set false to skip the live fetch at startup (trigger it from the dashboard instead)
INGESTION_ON_STARTUP=true
